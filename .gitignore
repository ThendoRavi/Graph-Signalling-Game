# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Results / artifacts: ignore everything under results/ EXCEPT figure images
# (PNG/PDF) and the directory structure. Logs, .npy matrices, large model
# checkpoints, etc. stay ignored so the repo doesn't bloat.
results/**/*
# re-include directories so git descends into them to find the PNGs below
!results/**/
# track figure images (and any vector figures)
!results/**/*.png
!results/**/*.pdf
# small per-run / summary tables (q1_hypothesis.sh) for the write-up
!results/**/*.csv
!results/**/.gitkeep
*.ckpt
*.pt
*.npz

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Thesis Paper (Overleaf project: LaTeX source, generated PDF, figures) --
# not tracked in this code repo
Thesis Paper/
